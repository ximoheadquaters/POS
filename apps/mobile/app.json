{
  "expo": {
    "name": "Ximo POS",
    "slug": "ximo-pos",
    "scheme": "ximopos",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Ximo POS to use the camera to scan product barcodes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "android": {
      "package": "com.ximo.pos",
      "adaptiveIcon": {
        "backgroundColor": "#0f766e"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
