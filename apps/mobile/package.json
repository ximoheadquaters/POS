{
  "name": "@ximo/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "node --env-file-if-exists=../../.env node_modules/expo/bin/cli start",
    "android": "node --env-file-if-exists=../../.env node_modules/expo/bin/cli start --android",
    "build": "node --env-file-if-exists=../../.env node_modules/expo/bin/cli export --platform android --output-dir dist",
    "build:web": "pnpm --filter @ximo/shared build && node --env-file-if-exists=../../.env node_modules/expo/bin/cli export --platform web --output-dir dist-web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && jest --runInBand"
  },
  "dependencies": {
    "@babel/runtime": "7.29.7",
    "@expo/metro-runtime": "~6.1.2",
    "@hookform/resolvers": "5.5.3",
    "@supabase/supabase-js": "2.110.8",
    "@tanstack/react-query": "5.101.4",
    "@ximo/shared": "0.1.0",
    "expo": "~54.0.0",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "nativewind": "4.2.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "7.83.0",
    "react-native": "0.81.5",
    "react-native-css-interop": "0.2.6",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "4.16.0",
    "react-native-url-polyfill": "3.0.0",
    "react-native-web": "0.21.0",
    "react-native-worklets": "0.5.1",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "7.29.7",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.1.17",
    "babel-preset-expo": "~54.0.12",
    "jest": "29.7.0",
    "jest-expo": "54.0.17",
    "tailwindcss": "3.4.19",
    "test-renderer": "1.1.0",
    "vitest": "4.1.10"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/*.ui.test.tsx"
    ]
  }
}
