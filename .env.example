# API only. Never copy the service role key into the mobile environment.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:password@localhost:5432/ximo_pos
DATABASE_SSL=false
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=product-images
# Required owner password-setup page (production POS web).
PLATFORM_OWNER_INVITE_REDIRECT_URL=https://ximo-pos-web.onrender.com/accept-invitation
LOG_LEVEL=info
DEMO_OWNER_PASSWORD=choose-a-unique-local-password
DEMO_MANAGER_PASSWORD=choose-a-unique-local-password
DEMO_CASHIER_1_PASSWORD=choose-a-unique-local-password
DEMO_CASHIER_2_PASSWORD=choose-a-unique-local-password

# Mobile public values. EXPO_PUBLIC_* values are embedded in the app.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api/v1
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
